{
  "name": "@tinify-dev/mcp",
  "version": "0.1.4",
  "description": "MCP server for the Tinify.dev image API: compress, resize, crop, and convert images from Claude, Cursor, or any MCP client.",
  "license": "MIT",
  "author": "Stian Larsen",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tinify-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tinify",
    "image",
    "compression",
    "resize",
    "crop",
    "avif",
    "webp",
    "claude",
    "cursor"
  ],
  "scripts": {
    "build": "tsup",
    "build:remote": "tsup --config tsup.remote.config.ts",
    "start:remote": "node dist-remote/http.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/stdio-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tinify-dev/client": "^0.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "mcpName": "dev.tinify/mcp"
}
